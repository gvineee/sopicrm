APP_NAME="ODA CRM"
APP_ENV=local
APP_KEY=
# Audit A01 (P0): APP_DEBUG=true renders Ignition's full diagnostic page —
# SQL, stack trace, file paths and the request's own headers/cookies — to
# whoever triggered the error. That page reached real users once already,
# because this same instance is what a public tunnel serves. Keep it true
# ONLY on a machine that is not reachable from outside; anything exposed
# (tunnel, staging, production) must run APP_DEBUG=false, where
# resources/views/errors/500.blade.php shows a reference id instead and the
# detail stays in the server log under that same id.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL — see infra/docker-compose.yml "postgres" service and docs/architecture.md §4.
# DB_USERNAME must be a non-superuser, non-table-owner role (oda_app) for Postgres
# Row-Level Security to take effect once RLS policies are added (docs/architecture.md §4);
# the docker-compose postgres service provisions this role and database on first boot.
# These host-oriented defaults (127.0.0.1) are for running `php artisan serve` on the host
# against the dockerized Postgres port mapping; the app/worker/scheduler containers in
# infra/docker-compose.yml override DB_HOST to the "postgres" service name instead.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=oda_crm
DB_USERNAME=oda_app
DB_PASSWORD=secret

# Redis-backed sessions/cache/queue in every environment (dev included) so local
# behavior matches staging/production and RLS/tenant-context bugs that only show up
# with a real Redis-backed queue worker are caught early. See docs/decisions.md.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE left unset (falsy) here for local HTTP dev. Spec
# section 21 requires secure session cookies — staging/production .env MUST
# set SESSION_SECURE_COOKIE=true once served over HTTPS (config/session.php
# 'secure' => env('SESSION_SECURE_COOKIE')). http_only (true) and
# same_site (lax) already default correctly and don't need overriding.

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit (mailhog-compatible local mail catcher) — see infra/docker-compose.yml "mailpit" service.
# Web UI at http://127.0.0.1:8025 once the stack is running.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# NOTIFY-01: no real Telegram Bot API implementation exists yet — only
# App\Domain\Notifications\Adapters\FakeTelegramTransport is bound (see
# app/Providers/Notifications/NotificationsModuleServiceProvider.php). This
# key is a placeholder for whenever a real transport is built; never set a
# real token in a committed file.
TELEGRAM_BOT_TOKEN=

# Private, S3-compatible file storage (docs/decisions.md DEC-010). Local dev/CI point this
# at the "minio" service in infra/docker-compose.yml; staging/prod point it at a real
# S3-compatible provider (not yet chosen — see docs/decisions.md § Open business-policy
# questions #6). Uploads must always go to a PRIVATE bucket/disk — never public — with
# access only via signed, short-lived, policy-checked download URLs.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=oda-crm-local
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
